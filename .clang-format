---
Language: Cpp
BasedOnStyle: LLVM
Standard: c++20

# Indent / width
UseTab: Never
IndentWidth: 4
TabWidth: 4
ContinuationIndentWidth: 4
ColumnLimit: 120

# Braces (Allman, UE-style)
BreakBeforeBraces: Allman

# Pointers and references hug the type (int* p, int& r)
PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false

# Spacing
SpaceAfterTemplateKeyword: true
SpaceBeforeParens: ControlStatements
SpacesBeforeTrailingComments: 1

# Class layout
AccessModifierOffset: -4

# Wrapping
AllowAllParametersOfDeclarationOnNextLine: false
AllowShortBlocksOnASingleLine: Empty
AllowShortCaseLabelsOnASingleLine: false
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AlwaysBreakTemplateDeclarations: Yes
BinPackArguments: false
BinPackParameters: false
BreakConstructorInitializers: BeforeColon
ConstructorInitializerAllOnOneLineOrOnePerLine: true
IndentCaseLabels: false
NamespaceIndentation: All

# Includes — preserve author-grouped order (UE convention groups: own header, engine, plugin, third-party)
SortIncludes: CaseSensitive
IncludeBlocks: Preserve

# Force wrapping when over column limit rather than packing
PenaltyBreakAssignment: 100
PenaltyBreakBeforeFirstCallParameter: 100
PenaltyBreakComment: 100
PenaltyBreakString: 1000
PenaltyExcessCharacter: 1000000
PenaltyReturnTypeOnItsOwnLine: 100
